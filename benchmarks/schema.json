{
 "$defs": {
  "Links": {
   "additionalProperties": false,
   "properties": {
    "paper": {
     "default": "",
     "title": "Paper",
     "type": "string"
    },
    "code": {
     "default": "",
     "title": "Code",
     "type": "string"
    },
    "weights": {
     "default": "",
     "title": "Weights",
     "type": "string"
    }
   },
   "title": "Links",
   "type": "object"
  },
  "Method": {
   "additionalProperties": false,
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "kind": {
     "default": "model",
     "enum": [
      "model",
      "baseline"
     ],
     "title": "Kind",
     "type": "string"
    },
    "description": {
     "default": "",
     "title": "Description",
     "type": "string"
    },
    "meidnet_version": {
     "default": "",
     "title": "Meidnet Version",
     "type": "string"
    },
    "parameters": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Parameters"
    },
    "training_data": {
     "default": "",
     "title": "Training Data",
     "type": "string"
    },
    "checkpoint": {
     "default": "",
     "title": "Checkpoint",
     "type": "string"
    },
    "checkpoint_sha256": {
     "default": "",
     "pattern": "^([0-9a-f]{64})?$",
     "title": "Checkpoint Sha256",
     "type": "string"
    },
    "links": {
     "$ref": "#/$defs/Links",
     "default": {
      "paper": "",
      "code": "",
      "weights": ""
     }
    }
   },
   "required": [
    "name"
   ],
   "title": "Method",
   "type": "object"
  },
  "Reproduce": {
   "additionalProperties": false,
   "properties": {
    "command": {
     "default": "",
     "title": "Command",
     "type": "string"
    },
    "hardware": {
     "default": "",
     "title": "Hardware",
     "type": "string"
    },
    "wall_time_s": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Wall Time S"
    }
   },
   "title": "Reproduce",
   "type": "object"
  },
  "Submitter": {
   "additionalProperties": false,
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "affiliation": {
     "default": "",
     "title": "Affiliation",
     "type": "string"
    },
    "github": {
     "default": "",
     "title": "Github",
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "title": "Submitter",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "id": {
   "pattern": "^[a-z0-9][a-z0-9-]{2,60}$",
   "title": "Id",
   "type": "string"
  },
  "dataset": {
   "pattern": "^[a-z0-9][a-z0-9_-]{1,40}$",
   "title": "Dataset",
   "type": "string"
  },
  "protocol": {
   "description": "the protocol version the results follow, or 'paper' for numbers quoted from the paper",
   "title": "Protocol",
   "type": "string"
  },
  "date": {
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
   "title": "Date",
   "type": "string"
  },
  "submitter": {
   "$ref": "#/$defs/Submitter"
  },
  "modalities": {
   "items": {
    "type": "string"
   },
   "minItems": 1,
   "title": "Modalities",
   "type": "array"
  },
  "method": {
   "$ref": "#/$defs/Method"
  },
  "results": {
   "additionalProperties": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "type": "object"
   },
   "description": "task id -> metric id -> value",
   "minProperties": 1,
   "title": "Results",
   "type": "object"
  },
  "validation_level": {
   "default": "generated",
   "enum": [
    "generated",
    "ml_filtered",
    "mlip_validated",
    "dft_validated",
    "experimentally_validated"
   ],
   "title": "Validation Level",
   "type": "string"
  },
  "evidence": {
   "default": [],
   "items": {
    "type": "string"
   },
   "title": "Evidence",
   "type": "array"
  },
  "artifacts": {
   "additionalProperties": {
    "type": "string"
   },
   "default": {},
   "description": "task id -> folder with the outputs behind the numbers",
   "title": "Artifacts",
   "type": "object"
  },
  "reproduce": {
   "$ref": "#/$defs/Reproduce",
   "default": {
    "command": "",
    "hardware": "",
    "wall_time_s": null
   }
  },
  "status": {
   "default": "community_submitted",
   "enum": [
    "community_submitted",
    "published",
    "meidnet_verified"
   ],
   "title": "Status",
   "type": "string"
  },
  "verified_by": {
   "default": "",
   "title": "Verified By",
   "type": "string"
  },
  "verified_on": {
   "default": "",
   "title": "Verified On",
   "type": "string"
  },
  "notes": {
   "default": "",
   "title": "Notes",
   "type": "string"
  }
 },
 "required": [
  "id",
  "dataset",
  "protocol",
  "date",
  "submitter",
  "modalities",
  "method",
  "results"
 ],
 "title": "Submission",
 "type": "object",
 "$comment": "Task and metric ids come from the dataset's protocol (benchmarks/datasets/<dataset>.json)."
}